							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function() {\r",
									"    pm.response.to.have.status(201);\r",
									"});\r",
									"\r",
									"pm.test(\"Status value is OK\", function() {\r",
									"    pm.expect(pm.response.status).to.be.oneOf(['OK','Created']);\r",
									"});\r",
									"\r",
									"pm.test(\"Response time should be less than 30 ms\", function() {\r",
									"    pm.expect(pm.response.responseTime).to.be.below(30);\r",
									"});\r",
									"\r",
									"pm.test(\"Response size should be between 200 KB to 400 KB\", function() {\r",
									"    pm.expect(pm.response.responseSize).to.be.below(400);\r",
									"    pm.expect(pm.response.responseSize).to.be.above(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Check Content-Type\", function() {\r",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
									"});\r",
									"\r",
									"var jsonData = pm.response.json();\r",
									"\r",
									"pm.test(\"Check Name\", function() {\r",
									"    pm.expect(jsonData.name).not.equal(null);\r",
									"});\r",
									"\r",
									"pm.test(\"Check Email\", function() {\r",
									"    pm.expect(jsonData.email).not.equal(null);\r",
									"});"
